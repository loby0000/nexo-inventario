/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Independent app build and local tooling
/standalone/dist/
/standalone/.wrangler/
/supabase/.temp/
/standalone/work/
/standalone/connector/bin/
/standalone/connector/obj/
/standalone/public/downloads/*.exe
